<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="question/type/structuredsteps/db" VERSION="2026022203" COMMENT="XMLDB file for qtype_structuredsteps"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="qtype_structuredsteps_options" COMMENT="Options for structuredsteps questions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Foreign key references question.id."/>
        <FIELD NAME="schema_version" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="1.0" SEQUENCE="false"/>
        <FIELD NAME="engine" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="long_multiplication" SEQUENCE="false"/>
        <FIELD NAME="engine_version" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="1.0" SEQUENCE="false"/>
        <FIELD NAME="model_json" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionid" TYPE="foreign-unique" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="qtype_structuredsteps_analytics" COMMENT="Analytics fact rows for structuredsteps attempts">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="engine" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="long_multiplication" SEQUENCE="false"/>
        <FIELD NAME="step_error_summary" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="dominant_error" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="none" SEQUENCE="false"/>
        <FIELD NAME="total_score" TYPE="number" LENGTH="12" DECIMALS="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="max_score" TYPE="number" LENGTH="12" DECIMALS="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="tenantid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_qssa_tenant_time" UNIQUE="false" FIELDS="tenantid, timecreated"/>
        <INDEX NAME="idx_qssa_tenant_question_time" UNIQUE="false" FIELDS="tenantid, questionid, timecreated"/>
        <INDEX NAME="idx_qssa_tenant_engine_time" UNIQUE="false" FIELDS="tenantid, engine, timecreated"/>
        <INDEX NAME="idx_qssa_attempt" UNIQUE="false" FIELDS="attemptid"/>
        <INDEX NAME="idx_qssa_user_time" UNIQUE="false" FIELDS="userid, timecreated"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="qtype_structuredsteps_cjob" COMMENT="Converter orchestration jobs">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="tenantid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="sourceqtype" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="all" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="queued" SEQUENCE="false"/>
        <FIELD NAME="confidence_threshold" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="85" SEQUENCE="false"/>
        <FIELD NAME="dryrun" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="requestedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="approvedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="runid" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="pending" SEQUENCE="false"/>
        <FIELD NAME="totalscanned" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="totalconverted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="totalreview" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="totalfailed" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="aiinvoked" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="errorcode" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="none" SEQUENCE="false"/>
        <FIELD NAME="errormessage" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="payloadjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="reportjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timestarted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timefinished" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="retrycount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_qsscjob_status_time" UNIQUE="false" FIELDS="status, timemodified"/>
        <INDEX NAME="idx_qsscjob_tenant_time" UNIQUE="false" FIELDS="tenantid, timemodified"/>
        <INDEX NAME="idx_qsscjob_category" UNIQUE="false" FIELDS="categoryid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="qtype_structuredsteps_clog" COMMENT="Converter audit log entries">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="jobid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="oldquestionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="newquestionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="tenantid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="coursecatid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="engine" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="unknown" SEQUENCE="false"/>
        <FIELD NAME="confidence" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="finalconfidence" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="manual_review" SEQUENCE="false"/>
        <FIELD NAME="aiengaged" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="explanation" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="errorcode" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="none" SEQUENCE="false"/>
        <FIELD NAME="rawproposal" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_qssclog_job" UNIQUE="false" FIELDS="jobid"/>
        <INDEX NAME="idx_qssclog_status_time" UNIQUE="false" FIELDS="status, timecreated"/>
        <INDEX NAME="idx_qssclog_tenant_time" UNIQUE="false" FIELDS="tenantid, timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
